{
  "name": "notification-service",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "npm run build:all && tsc -p . && npm run copy-static-assets",
    "tsoa:gen": "yarn tsoa swagger -c ./api/tsoa.json && yarn tsoa routes -c ./api/tsoa.json",
    "clean": "rimraf dist",
    "test": "ENVIRONMENT=../../env/test mocha -r ts-node/register src/**/*.spec.ts src/**/**/*.spec.ts --timeout 10000 --exit",
    "copy-static-assets": "ts-node copyStaticAssets.ts",
    "dev": "npm run build && concurrently \"nodemon --inspect\" \"nodemon -x tsoa spec-and-routes\"",
    "start": "npm run clean && npm run build && node dist/src/infrastructure/server.js",
    "postinstall": "typings install",
    "build:routes": "mkdir -p src/infrastructure/routes && tsoa routes",
    "build:swagger": "mkdir -p api && mkdir -p api/dist && tsoa swagger",
    "build:all": "npm run build:routes && npm run build:swagger",
    "start-local": "ENVIRONMENT=local npm start"
  },
  "author": "amit maurya",
  "license": "ISC",
  "dependencies": {
    "@types/superagent": "^4.1.10",
    "@types/swagger-ui-express": "^4.1.2",
    "body-parser": "^1.19.0",
    "cors": "^2.8.5",
    "dotenv": "^8.2.0",
    "email-validator": "^2.0.4",
    "eosjs": "^22.1.0",
    "errorhandler": "^1.5.1",
    "express": "^4.17.1",
    "faker": "^4.1.0",
    "firebase-admin": "^10.1.0",
    "handlebars": "^4.7.7",
    "ipfs-http-client": "^48.1.1",
    "json2csv": "^5.0.5",
    "jsonwebtoken": "^8.5.1",
    "mongoose": "^6.2.9",
    "morgan": "^1.10.0",
    "multer": "^1.4.2",
    "node-fetch": "^2.6.7",
    "nodemailer": "^6.7.3",
    "nodemailer-smtp-transport": "^2.7.4",
    "on-finished": "^2.3.0",
    "prom-client": "^13.1.0",
    "q": "^1.5.1",
    "superagent": "^6.1.0",
    "swagger-ui-express": "^4.3.0",
    "tsoa": "^3.14.1",
    "uuid": "^8.1.0",
    "winston": "^3.2.1"
  },
  "devDependencies": {
    "@types/chai": "^4.2.11",
    "@types/errorhandler": "^1.5.0",
    "@types/express": "^4.17.6",
    "@types/faker": "^4.1.12",
    "@types/json2csv": "^5.0.1",
    "@types/jsonwebtoken": "^8.5.0",
    "@types/mocha": "^7.0.2",
    "@types/morgan": "^1.9.0",
    "@types/multer": "^1.4.4",
    "@types/node": "^14.0.5",
    "@types/nodemailer": "^6.4.1",
    "@types/nodemailer-smtp-transport": "^2.7.4",
    "@types/on-finished": "^2.3.1",
    "@types/q": "^1.5.4",
    "@types/shelljs": "^0.8.8",
    "@types/uuid": "^8.0.0",
    "chai": "^4.2.0",
    "concurrently": "^7.1.0",
    "mocha": "^9.2.2",
    "nodemon": "^2.0.4",
    "shelljs": "^0.8.5",
    "ts-node": "^8.10.2",
    "typescript": "^4.6.3",
    "typings": "^2.1.1"
  }
}
