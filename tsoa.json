{
  "swagger": {

  },
    "securityDefinitions": {
      "jwt": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header"
      }
    },
    "basePath": "/notification/api/v1",
    "entryFile": "./src/infrastructure/server.ts",
    "specVersion": 3,
    "outputDirectory": "./api/dist",
    "controllerPathGlobs": [
      "src/interfaces/controllers/**/*Controller.ts"
    ],
    "specMerging": "recursive",
    "spec": {
      "servers": [
        {
          "url": "http://localhost:3006/notification/api/v1"
        },
        {
          "url": "https://nse-dev-api.shinetrace.space/notification/api/v1"
        },
        {
          "url": "https://shine-staging-api-1.shinetrace.space/notification/api/v1"
        },
        {
          "url": "https://shine-api-1.shinetrace.space/notification/api/v1"
        }
      ],
      "specVersion": 3,
      "outputDirectory": "./api/dist"
    },
  "routes": {
    "authenticationModule": "./src/application/security/authentication.ts",
    "basePath": "/api/v1",
    "entryFile": "./src/infrastructure/server.ts",
    "routesDir": "./src/infrastructure/routes",
    "middleware": "express"
  }
}